<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-vimix">
        <comment>vimix session</comment>
        <sub-class-of type="application/xml"/>
        <glob pattern="*.mix"/>
        <root-XML namespaceURI="" localName="vimix"/>
    </mime-type>
    <mime-type type="application/x-vimix-playlist">
        <comment>vimix playlist</comment>
        <sub-class-of type="application/xml"/>
        <glob pattern="*.lix"/>
        <root-XML namespaceURI="" localName="vimixplaylist"/>
    </mime-type>
</mime-info>
