{
    "app-id": "io.github.brunoherbelin.Vimix",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "launch_vimix.sh",
    "rename-desktop-file": "vimix.desktop",
    "rename-icon": "vimix",
    "finish-args": [
        "--socket=x11",
        "--socket=pulseaudio",
        "--system-talk-name=org.freedesktop.Avahi",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--device=shm",
        "--device=all",
        "--filesystem=xdg-videos",
        "--filesystem=xdg-pictures",
        "--filesystem=xdg-music",
        "--filesystem=xdg-download",
        "--filesystem=xdg-documents",
        "--filesystem=/run/media",
        "--filesystem=/media",
        "--filesystem=xdg-run/vimix:create",
        "--filesystem=xdg-run/pipewire-0",
        "--persist=.config/vimix",
        "--talk-name=org.gtk.vfs.*",
        "--env=FREI0R_PATH=/app/lib/frei0r-1"
    ],
    "cleanup": [
        "/include",
        "/share/gdb",
        "/share/info",
        "/share/man",
        "/share/doc",
        "/lib/pkgconfig",
        "*.a"
    ],
    "modules": [
        {
            "name": "glfw",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_SHARED_LIBS=ON",
                "-DGLFW_BUILD_EXAMPLES=OFF",
                "-DGLFW_BUILD_TESTS=OFF",
                "-DGLFW_BUILD_DOCS=OFF"
            ],
            "sources": [
            {
                "type": "git",
                "tag": "3.5.1",
                "commit": "d9d6f0f1f967807ffade6598ea9a631ebaf37a56",
                "url": "https://github.com/glfw/glfw.git"
            }
            ]
        },
        {
            "name": "srt",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DENABLE_APPS=OFF",
                "-DENABLE_STDCXX_SYNC=ON"
            ],
            "sources": [
            {
                "type": "git",
                "tag": "v1.5.7",
                "commit": "899348d8318eb9a3c5a5b6ec43c4a1114288773a",
                "url": "https://github.com/Haivision/srt.git"
            }
            ]
        },
        {
            "name": "gst-plugin-srt",
            "buildsystem": "simple",
            "build-commands": [
                "meson setup _build --prefix=/app --buildtype=release -Dauto_features=disabled -Dsrt=enabled",
                "ninja -C _build ext/srt/libgstsrt.so",
                "install -Dm755 _build/ext/srt/libgstsrt.so /app/lib/gstreamer-1.0/libgstsrt.so"
            ],
            "sources": [
            {
                "type": "archive",
                "url": "https://gstreamer.freedesktop.org/src/gst-plugins-bad/gst-plugins-bad-1.28.6.tar.xz",
                "sha256": "6636f2c2289ceda52c4aba971338c81e2b5780d3381bd3673c1c116ec87587c3"
            }
            ]
        },
        {
            "name": "frei0r",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DWITHOUT_OPENCV=ON",
                "-DWITHOUT_GAVL=ON",
                "-DWITHOUT_FACERECOGNITION=ON",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
            {
                "type": "git",
                "tag": "v2.5.6",
                "commit": "530f7e6388c6931f20aa2ca9e4ea33a60df7aca7",
                "url": "https://github.com/dyne/frei0r.git"
            }
            ]
        },
        {
            "name": "vimix",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                "type": "git",
                "branch": "beta",
                "url": "https://github.com/brunoherbelin/vimix.git"
                },
                {
                "type": "git",
                "url": "https://github.com/Tencent/ncnn.git",
                "commit": "b4ba207c18d3103d6df890c0e3a97b469b196b26",
                "disable-submodules": true,
                "dest": "ext/ncnn"
                },
                {
                "type": "git",
                "url": "https://github.com/KhronosGroup/glslang.git",
                "commit": "86ff4bca1ddc7e2262f119c16e7228d0efb67610",
                "disable-submodules": true,
                "dest": "ext/ncnn/glslang"
                },
                {
                "type": "git",
                "url": "https://github.com/nihui/rife-ncnn-vulkan.git",
                "commit": "a7532fc3f9f8f008cd6eecd6f2ffe2a9698e0cf7",
                "disable-submodules": true,
                "dest": "ext/rife-ncnn-vulkan"
                },
                {
                "type": "git",
                "url": "https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan.git",
                "commit": "37026f49824c5cf84062e7c6a5dd71445dcf610f",
                "disable-submodules": true,
                "dest": "ext/realesrgan-ncnn-vulkan"
                }
            ]
        }
    ]
}
